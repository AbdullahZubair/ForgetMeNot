<?php

/**
 * @file
 * ForgetMeNot: Drupal 7 module to exclude projects from update checks.
 * 
 * This module provides a comprehensive interface for site administrators to manage
 * which projects (modules, themes, and Drupal core) should be excluded from
 * update status checks. This is particularly useful for EOL Drupal 7 sites
 * where update warnings are no longer relevant.
 * 
 * @author Abdullah Zubair
 * @version 2.0
 * @package ForgetMeNot
 */

// Define module constants.
define('FORGET_ME_NOT_VARIABLE_NAME', 'forget_me_not_excluded_projects');
define('FORGET_ME_NOT_PERMISSION', 'administer site configuration');
define('FORGET_ME_NOT_BASE_PATH', 'admin/config/system/forget_me_not');

/**
 * Implements hook_menu().
 * 
 * Defines the administrative interface routes for managing excluded projects.
 * 
 * @return array
 *   An array of menu items.
 */
function forget_me_not_menu() {
  $items = array();

  // Main administration page.
  $items[FORGET_ME_NOT_BASE_PATH] = array(
    'title' => 'Manage Excluded Projects',
    'description' => 'View and manage projects excluded from update status checks.',
    'page callback' => 'forget_me_not_admin_page',
    'access arguments' => array(FORGET_ME_NOT_PERMISSION),
    'type' => MENU_NORMAL_ITEM,
    'file' => 'forget_me_not.admin.inc',
  );

  // Project selection form.
  $items[FORGET_ME_NOT_BASE_PATH . '/select'] = array(
    'title' => 'Select Projects to Exclude',
    'description' => 'Choose which projects to exclude from update checks.',
    'page callback' => 'drupal_get_form',
    'page arguments' => array('forget_me_not_select_projects_form'),
    'access arguments' => array(FORGET_ME_NOT_PERMISSION),
    'type' => MENU_LOCAL_ACTION,
    'file' => 'forget_me_not.admin.inc',
  );

  // AJAX callback for project removal.
  $items[FORGET_ME_NOT_BASE_PATH . '/remove'] = array(
    'page callback' => 'forget_me_not_ajax_remove_project',
    'access arguments' => array(FORGET_ME_NOT_PERMISSION),
    'type' => MENU_CALLBACK,
    'file' => 'forget_me_not.admin.inc',
  );

  return $items;
}

/**
 * Implements hook_permission().
 * 
 * Defines permissions for this module (though we use existing Drupal permission).
 * 
 * @return array
 *   An array of permissions.
 */
function forget_me_not_permission() {
  return array(
    'manage excluded projects' => array(
      'title' => t('Manage excluded projects'),
      'description' => t('Add and remove projects from update check exclusions.'),
    ),
  );
}

/**
 * Implements hook_help().
 * 
 * Provides help and documentation for the module.
 * 
 * @param string $path
 *   The path for which to provide help.
 * @param array $arg
 *   An array of arguments.
 * 
 * @return string|null
 *   Help text or NULL if no help is available.
 */
function forget_me_not_help($path, $arg) {
  switch ($path) {
    case 'admin/help#forget_me_not':
      $output = '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('The ForgetMeNot module allows site administrators to exclude specific projects (modules, themes, and Drupal core) from update status checks. This is particularly useful for end-of-life Drupal 7 sites where update notifications are no longer relevant.') . '</p>';
      $output .= '<h3>' . t('Uses') . '</h3>';
      $output .= '<dl>';
      $output .= '<dt>' . t('Excluding modules and themes') . '</dt>';
      $output .= '<dd>' . t('Selected modules and themes will be completely removed from the update status report.') . '</dd>';
      $output .= '<dt>' . t('Excluding Drupal core') . '</dt>';
      $output .= '<dd>' . t('Drupal core will appear as "up to date" with a note that update checks are disabled.') . '</dd>';
      $output .= '</dl>';
      return $output;
  }
}

/**
 * Retrieves the list of excluded projects.
 * 
 * @return array
 *   An array of project machine names that are excluded from update checks.
 */
function forget_me_not_get_excluded_projects() {
  return variable_get(FORGET_ME_NOT_VARIABLE_NAME, array());
}

/**
 * Saves the list of excluded projects.
 * 
 * @param array $projects
 *   An array of project machine names to exclude from update checks.
 * 
 * @return bool
 *   TRUE on success, FALSE on failure.
 */
function forget_me_not_save_excluded_projects(array $projects) {
  // Validate input - ensure it's an array of strings.
  $projects = array_filter($projects, 'is_string');
  $projects = array_unique($projects);
  
  // Save to variables table.
  variable_set(FORGET_ME_NOT_VARIABLE_NAME, $projects);
  
  // Clear relevant caches.
  forget_me_not_clear_caches();
  
  return TRUE;
}

/**
 * Determines the type of a given project.
 * 
 * @param string $project_name
 *   The machine name of the project.
 * 
 * @return string
 *   The project type: 'core', 'module', 'theme', or 'unknown'.
 */
function forget_me_not_get_project_type($project_name) {
  // Validate input.
  if (!is_string($project_name) || empty($project_name)) {
    return 'unknown';
  }
  
  // Check for Drupal core.
  if ($project_name === 'drupal') {
    return 'core';
  }
  
  // Check if it's a theme.
  $themes = list_themes();
  if (isset($themes[$project_name])) {
    return 'theme';
  }
  
  // Check if it's a module.
  $modules = system_rebuild_module_data();
  if (isset($modules[$project_name])) {
    return 'module';
  }
  
  return 'unknown';
}

/**
 * Gets available projects that can be excluded.
 * 
 * @param array $excluded_projects
 *   Currently excluded projects to filter out.
 * 
 * @return array
 *   An associative array with project types as keys and project arrays as values.
 */
function forget_me_not_get_available_projects(array $excluded_projects = array()) {
  $available = array(
    'modules' => array(),
    'themes' => array(),
    'core' => array(),
  );
  
  // Get modules.
  $modules = system_rebuild_module_data();
  foreach ($modules as $name => $module) {
    if (!in_array($name, $excluded_projects) && $module->status) {
      $available['modules'][$name] = $module->info['name'];
    }
  }
  
  // Get themes.
  $themes = list_themes();
  foreach ($themes as $name => $theme) {
    if (!in_array($name, $excluded_projects) && !empty($theme->status)) {
      $available['themes'][$name] = $theme->info['name'];
    }
  }
  
  // Add Drupal core if not excluded.
  if (!in_array('drupal', $excluded_projects)) {
    $available['core']['drupal'] = t('Drupal Core');
  }
  
  return $available;
}

/**
 * Clears relevant caches after configuration changes.
 */
function forget_me_not_clear_caches() {
  // Clear update module caches.
  if (function_exists('_update_cache_clear')) {
    _update_cache_clear();
  }
  
  // Clear menu cache.
  menu_rebuild();
}

/**
 * Implements hook_update_status_alter().
 * 
 * Alters the project update status to exclude selected projects from update checks.
 * This is the core functionality that removes projects from update reports.
 * 
 * @param array $projects
 *   Reference to the projects array from the update system.
 */
function forget_me_not_update_status_alter(&$projects) {
  $excluded_projects = forget_me_not_get_excluded_projects();
  
  if (empty($excluded_projects)) {
    return;
  }

  foreach ($excluded_projects as $project_name) {
    if (!isset($projects[$project_name])) {
      continue;
    }
    
    // Special handling for Drupal core.
    if ($project_name === 'drupal') {
      $projects[$project_name] = forget_me_not_build_core_project_data($projects[$project_name]);
    }
    else {
      // For modules and themes, simply remove from the list.
      unset($projects[$project_name]);
    }
  }
}

/**
 * Builds cleaned project data for Drupal core.
 * 
 * @param array $original_data
 *   Original project data from the update system.
 * 
 * @return array
 *   Cleaned project data that shows core as "up to date".
 */
function forget_me_not_build_core_project_data(array $original_data) {
  // Extract required data with fallbacks.
  $existing_version = isset($original_data['existing_version']) ? $original_data['existing_version'] : '7.x';
  $datestamp = isset($original_data['datestamp']) ? $original_data['datestamp'] : REQUEST_TIME;
  $includes = isset($original_data['includes']) ? $original_data['includes'] : array();
  $install_type = isset($original_data['install_type']) ? $original_data['install_type'] : 'official';
  $info = isset($original_data['info']) ? $original_data['info'] : array();
  
  return array(
    'name' => 'drupal',
    'info' => $info,
    'datestamp' => $datestamp,
    'existing_version' => $existing_version,
    'status' => UPDATE_CURRENT,
    'reason' => t('Update checks disabled by ForgetMeNot module'),
    'title' => t('Drupal core (Updates disabled)'),
    'recommended' => $existing_version,
    'latest_version' => $existing_version,
    'project_type' => 'core',
    'project_status' => 'published',
    'install_type' => $install_type,
    'link' => 'https://www.drupal.org/project/drupal/releases/' . $existing_version,
    'includes' => $includes,
    'releases' => array(
      $existing_version => array(
        'version' => $existing_version,
        'date' => $datestamp,
        'status' => 'published',
        'release_link' => 'https://www.drupal.org/project/drupal/releases/' . $existing_version,
        'download_link' => 'https://www.drupal.org/project/drupal/releases/' . $existing_version,
      ),
    ),
    'extra_classes' => array('forget-me-not-excluded'),
  );
}

/**
 * Implements hook_init().
 * 
 * Adds CSS and JavaScript files on relevant admin pages.
 */
function forget_me_not_init() {
  // Only load assets on our admin pages.
  if (strpos(current_path(), FORGET_ME_NOT_BASE_PATH) === 0) {
    drupal_add_css(drupal_get_path('module', 'forget_me_not') . '/css/forget_me_not.css');
    drupal_add_js(drupal_get_path('module', 'forget_me_not') . '/js/forget_me_not.js');
  }
}

/**
 * Validates a project name for security.
 * 
 * @param string $project_name
 *   The project name to validate.
 * 
 * @return bool
 *   TRUE if valid, FALSE otherwise.
 */
function forget_me_not_validate_project_name($project_name) {
  // Check basic format (alphanumeric, underscores, hyphens).
  if (!preg_match('/^[a-zA-Z0-9_-]+$/', $project_name)) {
    return FALSE;
  }
  
  // Check length.
  if (strlen($project_name) > 50) {
    return FALSE;
  }
  
  return TRUE;
}
